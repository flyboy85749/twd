---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" noindex>
  <section class="wrap py-24">
    <h1>This page isn't here.</h1>
    <p class="measure mt-5 text-[1.15rem]">The link may be old, or the page may have moved. Try one of these instead:</p>
    <ul class="mt-6 space-y-2 font-display font-semibold">
      <li><a href="/">Home</a></li>
      <li><a href="/services/">Services</a></li>
      <li><a href="/pricing/">Pricing</a></li>
      <li><a href="/contact/">Contact</a></li>
    </ul>
  </section>
</Base>
