---
import Base from '../layouts/Base.astro';
import PricingTable from '../components/PricingTable.astro';
import ArchButton from '../components/ArchButton.astro';
import { priceLines, bundles, terms } from '../data/pricing';
---

<Base title="Pricing" description="Fixed, published prices for small business websites, AI chatbots, and n8n automation in Tucson. No hourly surprises.">
  <section class="wrap py-16">
    <h1>Pricing</h1>
    <p class="measure mt-5 text-[1.15rem] text-ink-soft">
      Published, fixed prices. You'll get a written quote before any work starts, and the price doesn't change unless
      the scope does.
    </p>
    <nav aria-label="Pricing sections" class="mt-8 flex flex-wrap gap-x-6 gap-y-2 font-display font-semibold">
      {priceLines.map((l) => <a href={`#${l.id}`}>{l.title}</a>)}
      <a href="#bundles">Bundles</a>
      <a href="#terms">Payment terms</a>
    </nav>
  </section>

  <div class="wrap grid gap-20 pb-20">
    {priceLines.map((line) => <PricingTable line={line} />)}

    <section id="bundles" class="scroll-mt-6">
      <h2>Bundles</h2>
      <p class="measure mt-3 text-ink-soft">Save when you combine services.</p>
      <ul class="mt-8 grid gap-6 md:grid-cols-3">
        {
          bundles.map((b) => (
            <li class="bundle">
              <h3>{b.name}</h3>
              <p class="mt-2 text-[1rem] text-ink-soft">{b.includes}</p>
              <p class="mt-3 font-display font-bold text-door-dark">{b.savings}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section id="terms" class="scroll-mt-6">
      <h2>Payment terms</h2>
      <ul class="prose-twd measure mt-6">
        {terms.map((t) => <li>{t}</li>)}
      </ul>
    </section>

    <section>
      <h2>Not sure which package fits?</h2>
      <p class="measure mt-4 text-ink-soft">Tell me about your business and I'll recommend one, even if it's the smallest.</p>
      <div class="mt-8">
        <ArchButton href="/contact/">Ask for a recommendation</ArchButton>
      </div>
    </section>
  </div>
</Base>

<style>
  .bundle {
    border: 2px solid var(--color-ink);
    border-radius: 0.375rem;
    padding: 1.5rem;
  }
  .text-door-dark {
    color: var(--color-door-dark);
  }
</style>
