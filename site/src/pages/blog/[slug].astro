---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ArchButton from '../../components/ArchButton.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', (p) => !p.data.draft);
  return posts.map((p) => ({ params: { slug: p.id }, props: { post: p } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
const date = post.data.date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
---

<Base title={post.data.title} description={post.data.description}>
  <article class="wrap py-16">
    <p class="font-display text-[0.95rem] font-semibold"><a href="/blog/">Blog</a></p>
    <h1 class="mt-3 max-w-[22ch]">{post.data.title}</h1>
    <p class="mt-4 text-ink-soft"><time datetime={post.data.date.toISOString()}>{date}</time></p>
    <div class="prose-twd measure mt-10">
      <Content />
    </div>
    <aside class="measure mt-14 border-t-[3px] border-ink pt-8">
      <h2 class="text-[1.4rem]">Want help with this?</h2>
      <p class="mt-3 text-ink-soft">I work with Tucson small businesses on exactly this kind of thing.</p>
      <div class="mt-6"><ArchButton href="/contact/">Start your project</ArchButton></div>
    </aside>
  </article>
</Base>
