---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';

const posts = (await getCollection('blog', (p) => !p.data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const [latest, ...rest] = posts;
const fmt = (d: Date) => d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
---

<Base title="Blog" description="Practical advice on websites, local SEO, and lead follow-up for Tucson small business owners.">
  <section class="wrap py-16">
    <h1>Blog</h1>
    <p class="measure mt-5 text-[1.15rem] text-ink-soft">
      Plain-language advice for small business owners on websites, getting found on Google, and following up with leads.
    </p>

    {
      latest && (
        <article class="post-link featured mt-12 grid items-center gap-8 lg:grid-cols-[1.35fr_1fr] lg:gap-12">
          <a href={`/blog/${latest.id}/`} class="cover" tabindex="-1" aria-hidden="true">
            <Image src={latest.data.cover} alt="" loading="eager" />
          </a>
          <div>
            <time datetime={latest.data.date.toISOString()} class="text-[0.95rem] text-ink-soft">
              {fmt(latest.data.date)}
            </time>
            <h2 class="mt-2">
              <a href={`/blog/${latest.id}/`}>{latest.data.title}</a>
            </h2>
            <p class="mt-4 text-ink-soft">{latest.data.description}</p>
          </div>
        </article>
      )
    }

    {
      rest.length > 0 && (
        <ul class="mt-16 grid gap-12 border-t border-line pt-12 md:grid-cols-2">
          {rest.map((p) => (
            <li class="post-link">
              <a href={`/blog/${p.id}/`} class="cover" tabindex="-1" aria-hidden="true">
                <Image src={p.data.cover} alt="" />
              </a>
              <time datetime={p.data.date.toISOString()} class="mt-5 block text-[0.95rem] text-ink-soft">
                {fmt(p.data.date)}
              </time>
              <h2 class="mt-2 text-[1.4rem]">
                <a href={`/blog/${p.id}/`}>{p.data.title}</a>
              </h2>
              <p class="mt-2 text-[1rem] text-ink-soft">{p.data.description}</p>
            </li>
          ))}
        </ul>
      )
    }
  </section>
</Base>

<style>
  /* The cover duplicates the title link, so it's hidden from keyboard and screen readers. */
  .cover {
    display: block;
    border: 2px solid var(--color-ink);
    border-radius: 0.375rem;
    overflow: hidden;
    aspect-ratio: 1200 / 630;
  }
  .cover :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .post-link h2 a {
    color: var(--color-ink);
    text-decoration: none;
  }
  .post-link h2 a:hover,
  .post-link:has(.cover:hover) h2 a {
    text-decoration: underline;
    text-decoration-thickness: 3px;
    text-decoration-color: var(--color-ochre);
  }
</style>
