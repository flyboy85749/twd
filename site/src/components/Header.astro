---
import Logo from './Logo.astro';
import { nav, site } from '../data/site';
const path = Astro.url.pathname;
---

<header class="border-b border-line bg-plaster">
  <div class="wrap flex items-center justify-between gap-4 py-4">
    <Logo />

    <nav aria-label="Main" class="hidden lg:block">
      <ul class="flex items-center gap-7 font-display text-[0.95rem] font-semibold">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                class="text-ink no-underline hover:underline"
                aria-current={path.startsWith(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
        <li>
          <a href={site.phoneHref} class="text-door-dark no-underline hover:underline">{site.phone}</a>
        </li>
      </ul>
    </nav>

    <details class="mobile-nav lg:hidden">
      <summary class="font-display font-semibold">Menu</summary>
      <nav aria-label="Main">
        <ul>
          {nav.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))}
          <li><a href="/contact/">Contact</a></li>
          <li><a href={site.phoneHref}>Call {site.phone}</a></li>
        </ul>
      </nav>
    </details>
  </div>
</header>

<style>
  [aria-current='page'] {
    text-decoration: underline;
    text-decoration-thickness: 3px;
    text-decoration-color: var(--color-ochre);
  }
  .mobile-nav {
    position: relative;
  }
  .mobile-nav summary {
    cursor: pointer;
    list-style: none;
    padding: 0.5rem 0.9rem;
    border: 2px solid var(--color-ink);
    border-radius: 0.375rem;
  }
  .mobile-nav summary::-webkit-details-marker {
    display: none;
  }
  .mobile-nav[open] summary {
    background: var(--color-ink);
    color: var(--color-plaster);
  }
  .mobile-nav nav {
    position: absolute;
    right: 0;
    top: calc(100% + 0.5rem);
    z-index: 20;
    min-width: 14rem;
    background: var(--color-plaster);
    border: 2px solid var(--color-ink);
    border-radius: 0.375rem;
    padding: 0.5rem 0;
  }
  .mobile-nav a {
    display: block;
    padding: 0.65rem 1.1rem;
    color: var(--color-ink);
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 600;
  }
  .mobile-nav a:hover {
    background: var(--color-wall);
  }
</style>
