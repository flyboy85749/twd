---
// The arched, door-shaped button. Reserved for primary actions only, so the shape always means "go here."
interface Props {
  href: string;
  variant?: 'door' | 'outline';
  class?: string;
}
const { href, variant = 'door', class: className = '' } = Astro.props;
---

<a href={href} class:list={['arch', `arch-${variant}`, className]}><slot /></a>

<style>
  .arch {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3.25rem;
    padding: 0.85rem 1.75rem 0.75rem;
    border-radius: 999px 999px 0.375rem 0.375rem;
    font-family: var(--font-display);
    font-variation-settings: 'wdth' 112;
    font-weight: 700;
    font-size: 1rem;
    line-height: 1.2;
    text-decoration: none;
    text-align: center;
    transition: background-color 120ms ease, color 120ms ease;
  }
  .arch-door {
    background: var(--color-door);
    color: #fff;
  }
  .arch-door:hover {
    background: var(--color-door-dark);
    color: #fff;
  }
  .arch-outline {
    color: var(--color-ink);
    box-shadow: inset 0 0 0 2px var(--color-ink);
  }
  .arch-outline:hover {
    background: var(--color-ink);
    color: var(--color-plaster);
  }
</style>
