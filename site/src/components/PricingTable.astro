---
import { type PriceLine, usd } from '../data/pricing';
interface Props {
  line: PriceLine;
  headingLevel?: 'h2' | 'h3';
}
const { line, headingLevel = 'h2' } = Astro.props;
const H = headingLevel;
---

<section id={line.id} class="min-w-0 scroll-mt-6">
  <H class="mb-2">{line.title}</H>
  <p class="measure mb-6 text-ink-soft">{line.summary}</p>

  <!-- Phones: one block per tier -->
  <div class="stack">
    {
      line.tiers.map((t, i) => (
        <div class="stack-tier">
          <p class="tier">{t.name}</p>
          <p class="price">{usd(t.price)} <span class="once">one time</span></p>
          <p class="best">{t.bestFor}</p>
          <dl>
            {line.features.map((f) => (
              <div>
                <dt>{f.label}</dt>
                <dd>
                  {f.values[i] === true ? (
                    <span class="yes">Included</span>
                  ) : f.values[i] === false ? (
                    <span class="no">Not included</span>
                  ) : (
                    f.values[i]
                  )}
                </dd>
              </div>
            ))}
            <div>
              <dt>Monthly</dt>
              <dd>{t.monthly}</dd>
            </div>
            <div>
              <dt>Delivery</dt>
              <dd>{t.delivery}</dd>
            </div>
          </dl>
          <a class="pick" href={`/contact/?package=${t.id}`}>
            Start with {t.name}
          </a>
        </div>
      ))
    }
  </div>

  <!-- Tablets and up: side-by-side comparison -->
  <div class="table-scroll" tabindex="0" role="region" aria-label={`${line.title} packages`}>
    <table>
      <caption class="sr-only">{line.title} packages compared</caption>
      <thead>
        <tr>
          <td></td>
          {
            line.tiers.map((t) => (
              <th scope="col">
                <span class="tier">{t.name}</span>
                <span class="price">{usd(t.price)}</span>
                <span class="once">one time</span>
                <span class="best">{t.bestFor}</span>
              </th>
            ))
          }
        </tr>
      </thead>
      <tbody>
        {
          line.features.map((f) => (
            <tr>
              <th scope="row">{f.label}</th>
              {f.values.map((v) => (
                <td>
                  {v === true ? (
                    <span class="yes">Included</span>
                  ) : v === false ? (
                    <span class="no">Not included</span>
                  ) : (
                    v
                  )}
                </td>
              ))}
            </tr>
          ))
        }
        <tr>
          <th scope="row">Monthly</th>
          {line.tiers.map((t) => <td>{t.monthly}</td>)}
        </tr>
        <tr>
          <th scope="row">Delivery</th>
          {line.tiers.map((t) => <td>{t.delivery}</td>)}
        </tr>
        <tr class="cta-row">
          <td></td>
          {
            line.tiers.map((t) => (
              <td>
                <a class="pick" href={`/contact/?package=${t.id}`}>
                  Start with {t.name}
                </a>
              </td>
            ))
          }
        </tr>
      </tbody>
    </table>
  </div>
  <p class="measure mt-4 text-[0.95rem] text-ink-soft">{line.monthlyNote}</p>
</section>

<style>
  .stack {
    display: grid;
    gap: 1.25rem;
  }
  .stack-tier {
    border: 2px solid var(--color-ink);
    border-radius: 0.375rem;
    padding: 1.25rem;
  }
  .stack-tier .tier,
  .stack-tier .best {
    display: block;
  }
  .stack-tier .price {
    display: block;
  }
  .stack dl {
    margin: 1rem 0 1.25rem;
    font-size: 0.95rem;
  }
  .stack dl > div {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
    padding: 0.5rem 0;
    border-top: 1px solid var(--color-line);
  }
  .stack dt {
    font-weight: 600;
  }
  .table-scroll {
    display: none;
    overflow-x: auto;
    border-top: 3px solid var(--color-ink);
  }
  table {
    width: 100%;
    min-width: 40rem;
    border-collapse: collapse;
    font-size: 1rem;
  }
  th,
  td {
    text-align: left;
    vertical-align: top;
    padding: 0.7rem 0.9rem;
    border-bottom: 1px solid var(--color-line);
  }
  thead th {
    width: 25%;
    padding-top: 1.1rem;
    padding-bottom: 1.1rem;
  }
  thead th > span {
    display: block;
  }
  .tier {
    font-family: var(--font-display);
    font-variation-settings: 'wdth' 125;
    font-weight: 800;
    font-size: 1.1rem;
  }
  .price {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 2rem;
    line-height: 1.1;
    margin-top: 0.35rem;
    color: var(--color-door-dark);
  }
  .once {
    font-size: 0.85rem;
    color: var(--color-ink-soft);
  }
  .best {
    margin-top: 0.6rem;
    font-weight: 400;
    font-size: 0.95rem;
    color: var(--color-ink-soft);
  }
  tbody th {
    font-weight: 600;
    width: 25%;
  }
  .yes {
    color: var(--color-saguaro);
    font-weight: 600;
  }
  .no {
    color: #6b7680;
  }
  .cta-row td {
    border-bottom: 0;
    padding-top: 1.1rem;
  }
  .pick {
    display: inline-block;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.95rem;
    padding: 0.55rem 1rem;
    border: 2px solid var(--color-door);
    border-radius: 0.375rem;
    text-decoration: none;
  }
  .pick:hover {
    background: var(--color-door);
    color: #fff;
  }
  /* Breakpoint swap last, so it overrides the base display rules above. */
  @media (min-width: 768px) {
    .stack {
      display: none;
    }
    .table-scroll {
      display: block;
    }
  }
</style>
