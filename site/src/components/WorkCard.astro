---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
interface Props {
  item: CollectionEntry<'work'>;
  eager?: boolean;
}
const { item, eager = false } = Astro.props;
const d = item.data;
---

<article>
  <div class="frame">
    <Image
      src={d.image}
      alt={d.imageAlt}
      widths={[480, 800, 1200]}
      sizes="(min-width: 768px) 50vw, 100vw"
      loading={eager ? 'eager' : 'lazy'}
      class="block h-auto w-full"
    />
  </div>
  <h3 class="mt-4">{d.url ? <a href={d.url}>{d.title}</a> : d.title}</h3>
  <p class="mt-1 text-[0.95rem] font-semibold text-wall-deep">{d.kind}</p>
  <p class="mt-2 text-[1rem] text-ink-soft">{d.summary}</p>
</article>

<style>
  .frame {
    border: 2px solid var(--color-ink);
    border-radius: 0.375rem;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    background: var(--color-line);
  }
  .frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }
  .text-wall-deep {
    color: #8f5546;
  }
</style>
